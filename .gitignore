.DS_Store
__pycache__/
*.py[cod]

# Local environment and credential files. Keep only explicit examples tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
credentials*.json
service-account*.json

# Machine-local Android/Gradle SDK location.
mobile/local.properties

# Personal BMAD installer answers and local customizations.
_bmad/config.user.toml
_bmad/custom/config.user.toml
_bmad/custom/*.user.toml

# Generated graphify data is machine-local and can be rebuilt from the repo.
graphify-out/

# Gradle/Kotlin and Xcode outputs are reproducible machine-local artifacts.
**/.gradle/
**/.kotlin/
**/build/
*.aar
_site/
**/DerivedData/
*.xcresult/
mobile/apps/iosApp/Pods/

# IDE metadata is machine-local; checked-in run configuration belongs in CI or
# the repository's documented command entrypoints.
**/.idea/
**/xcuserdata/

# npm caches and their debug logs are machine-local build residue, never review
# evidence. `backend/mobile-api/.npmrc` points npm at a product-local cache, but
# an npm invocation from any other directory still writes one where it runs.
**/.npm-cache/
