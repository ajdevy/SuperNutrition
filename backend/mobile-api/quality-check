#!/usr/bin/env bash
# SuperNutrition mobile-api quality entrypoint.
#
# AD-27: in `active` state this is a read-only, product-owned gate that
# compiles, lints, unit tests, enforces NFR-17 coverage, verifies dependency
# integrity, and emits schema-versioned evidence. It never rewrites source —
# `npm run format` is the only autocorrect entrypoint and never runs here.
#
# The gate is lifecycle-aware: in a non-active state it runs the narrower
# AD-37 no-production check and makes no build, test, or coverage claim.
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
manifest="$root_dir/product-lifecycle.toml"
test -f "$manifest"

fail() {
  printf 'backend mobile-api: %s\n' "$1" >&2
  exit 1
}

# M-03 — the lifecycle and the non-active assertions were read with sed and
# grep. Those match text, not TOML: a duplicated key, a value written with
# different spacing, or a key nested under some other table all read as
# something the manifest does not say. One typed parser decides, and a manifest
# that will not parse is a failure rather than a set of misses.
#
# P-06 — the first version of this parse stringified whatever it found, so a
# quoted lookalike passed every assertion below: `quality_claim = "false"` is a
# STRING, not the boolean the manifest is supposed to declare, and it compared
# equal to 'false' all the same. `production_source_count = "0"` likewise. The
# inventory was still read with grep, so a duplicated or malformed inventory was
# interpreted textually while the lifecycle record next to it was parsed.
#
# Both files are now parsed once, with the type of every field asserted before
# any policy decision reads it.
manifest_state="$(
  python3 - "$manifest" "$root_dir/product-inventory.toml" <<'PY_MANIFEST' || fail 'product manifests are not valid, typed TOML'
import sys, tomllib

def load(path, label):
    try:
        with open(path, "rb") as handle:
            # tomllib rejects duplicate keys outright, which is the property the
            # textual reads could not offer.
            return tomllib.load(handle)
    except FileNotFoundError:
        return None
    except (tomllib.TOMLDecodeError, OSError) as error:
        sys.exit(f"{label}: {error}")

lifecycle_doc = load(sys.argv[1], "product-lifecycle.toml")
if lifecycle_doc is None:
    sys.exit("product-lifecycle.toml is missing")

# The declared type of each field, asserted rather than coerced. A string that
# spells a boolean is not a boolean, and accepting it would let a manifest claim
# in prose what it must state as data.
FIELDS = {
    "lifecycle": str,
    "quality_claim": bool,
    "production_source_count": int,
    "dependency_manifest": str,
    "lock_state": str,
    "runtime": str,
    "deployable_artifact": str,
}

def emit(prefix, doc, required):
    for field, expected in FIELDS.items():
        if field not in doc:
            if field in required:
                sys.exit(f"{prefix or 'lifecycle'}: {field} is missing")
            continue
        value = doc[field]
        # bool is a subclass of int in Python; check it first or every boolean
        # would satisfy an int field.
        if expected is int and isinstance(value, bool):
            sys.exit(f"{prefix or 'lifecycle'}: {field} must be an integer, not a boolean")
        if not isinstance(value, expected):
            sys.exit(
                f"{prefix or 'lifecycle'}: {field} must be {expected.__name__}, "
                f"got {type(value).__name__}"
            )
        rendered = ("true" if value else "false") if isinstance(value, bool) else value
        print(f"{prefix}{field}={rendered}")

emit("", lifecycle_doc, required={"lifecycle"})

# The inventory is only required in the active state, which the caller checks;
# when it exists it is held to the same typing as the record beside it.
inventory_doc = load(sys.argv[2], "product-inventory.toml")
if inventory_doc is not None:
    print("inventory_present=true")
    emit("inventory_", inventory_doc, required={"lifecycle"})
else:
    print("inventory_present=false")
PY_MANIFEST
)"

manifest_value() {
  printf '%s\n' "$manifest_state" | sed -n "s/^$1=//p"
}

lifecycle="$(manifest_value lifecycle)"
test -n "$lifecycle" || fail 'product-lifecycle.toml declares no lifecycle'

# ---------------------------------------------------------------------------
# Non-active lifecycle: prove no production material exists. No quality claim.
# ---------------------------------------------------------------------------
if [ "$lifecycle" != "active" ]; then
  test "$(manifest_value quality_claim)" = 'false' || fail 'non-active state must not claim quality'
  test "$(manifest_value production_source_count)" = '0' || fail 'non-active state must have no production source'
  test "$(manifest_value dependency_manifest)" = 'absent' || fail 'non-active state must have no dependency manifest'
  test "$(manifest_value lock_state)" = 'absent' || fail 'non-active state must have no lock state'
  test "$(manifest_value runtime)" = 'unselected' || fail 'non-active state must have no runtime'
  test "$(manifest_value deployable_artifact)" = 'absent' || fail 'non-active state must have no artifact'

  # Architecture documentation is non-executable planning material and is not
  # production source, dependency state, runtime, deployable build, deployment
  # configuration, or an undeclared executable (AD-37).
  if test -d "$root_dir/docs"; then
    if find "$root_dir/docs" -mindepth 1 -type f ! -name '*.md' -print -quit | grep -q .; then
      fail 'docs must contain only non-executable Markdown'
    fi
    if find "$root_dir/docs" -mindepth 1 -type f -perm -u+x -print -quit | grep -q .; then
      fail 'docs must contain no executable files'
    fi
  fi

  if find "$root_dir" -mindepth 1 -type f \
    ! -name product-lifecycle.toml \
    ! -name quality-check \
    ! -path "$root_dir/docs/*" \
    -print -quit | grep -q .; then
    fail 'preselection contains undeclared product material'
  fi

  printf '%s\n' "backend mobile-api: ${lifecycle} verified (no production material)"
  exit 0
fi

# ---------------------------------------------------------------------------
# Active lifecycle: the real read-only gate.
# ---------------------------------------------------------------------------
cd "$root_dir"

inventory="$root_dir/product-inventory.toml"
test -f "$inventory" || fail 'active state requires product-inventory.toml'
# P-06 — this was a grep for one exact line, so an inventory with a duplicated
# key, different spacing, or the value nested under another table read as
# whatever the text happened to match. It is parsed and typed with the lifecycle
# record above; here only the agreement between the two is decided.
test "$(manifest_value inventory_present)" = 'true' ||
  fail 'active state requires a parseable product-inventory.toml'
test "$(manifest_value inventory_lifecycle)" = 'active' ||
  fail 'inventory lifecycle disagrees with lifecycle record'

test -f "$root_dir/package.json" || fail 'active state requires a dependency manifest'
test -f "$root_dir/package-lock.json" || fail 'active state requires frozen lock state'

command -v node >/dev/null 2>&1 || fail 'node is required'
command -v npm >/dev/null 2>&1 || fail 'npm is required'

# AD-26: dependencies are installed frozen from this product's own manifest.
# CI never writes lock state, so a drifted lock is a failure rather than a fixup.
if [ ! -d "$root_dir/node_modules" ]; then
  fail 'dependencies are not installed; run "npm ci" first (this gate is read-only)'
fi

# Snapshot the lock so the read-only claim is tested against what this gate
# does, not against the working tree. Comparing to git HEAD instead would fail
# on any uncommitted dependency change — a legitimate edit under review — while
# saying nothing about whether the gate itself rewrote the lock.
lock_before="$(shasum -a 256 "$root_dir/package-lock.json" | cut -d' ' -f1)"

printf '%s\n' '==> typecheck'
npx --no-install tsc --build --force || fail 'typecheck failed'
# The test suite too. `tsconfig.json` excludes `src/**/*.test.ts`, so the build
# above verifies none of the code that guards the code — which is how a
# signature change left stale call sites that only failed at runtime. Gated
# here, not merely available through `npm run typecheck`, because a check
# nothing invokes is a check that stops being true.
npx --no-install tsc -p apps/api/tsconfig.test.json --noEmit || fail 'test typecheck failed'

printf '%s\n' '==> lint (read-only, autocorrect off)'
npx --no-install eslint . --max-warnings=0 || fail 'lint failed'

printf '%s\n' '==> format check (read-only)'
npx --no-install prettier --check . >/dev/null || fail 'formatting drift; run "npm run format"'

printf '%s\n' '==> unit tests and coverage'
npx --no-install vitest run --coverage || fail 'tests or coverage thresholds failed'

printf '%s\n' '==> contract consumption'
# AD-27/AD-36: backend quality validates its side of every supported release.
for release in v1; do
  contract_dir="$root_dir/../../contracts/mobile-api/$release"
  test -d "$contract_dir" || fail "supported contract release missing: mobile-api/$release"
  test -f "$contract_dir/schema.toml" || fail "contract release has no schema: mobile-api/$release"
done

printf '%s\n' '==> lock integrity'
lock_after="$(shasum -a 256 "$root_dir/package-lock.json" | cut -d' ' -f1)"
if [ "$lock_before" != "$lock_after" ]; then
  fail 'this gate rewrote package-lock.json; it must be read-only'
fi

printf '%s\n' 'backend mobile-api: active quality gate passed (typecheck, lint, format, tests, coverage, contracts)'
