#!/usr/bin/env bash
# Read-only preselection gate for the backend product root.
#
# The backend is intentionally not activated yet. This entrypoint validates
# typed TOML metadata and rejects any undeclared product material without
# depending on formatting-sensitive grep/find pipelines.
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
manifest="$root_dir/product-lifecycle.toml"
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'backend mobile-api quality-check requires python3 for TOML validation' >&2
  exit 1
fi
test -f "$manifest" || {
  printf 'backend mobile-api: missing lifecycle manifest: %s\n' "$manifest" >&2
  exit 1
}

BACKEND_ROOT="$root_dir" BACKEND_MANIFEST="$manifest" python3 - <<'PY'
import os
import sys
import tomllib
from pathlib import Path

root = Path(os.environ["BACKEND_ROOT"])
manifest = Path(os.environ["BACKEND_MANIFEST"])
try:
    data = tomllib.loads(manifest.read_text(encoding="utf-8"))
except (OSError, tomllib.TOMLDecodeError) as error:
    raise SystemExit(f"backend mobile-api: invalid lifecycle TOML: {error}") from error

expected = {
    "schema": "supernutrition.backend.product-lifecycle.v1",
    "schema_version": 1,
    "product": "mobile-api",
    "lifecycle": "preselection",
    "source_digest": "pending",
    "quality_claim": False,
    "production_source_count": 0,
    "dependency_manifest": "absent",
    "lock_state": "absent",
    "runtime": "unselected",
    "deployable_artifact": "absent",
    "quality_entrypoint": "quality-check",
    "executable_inventory": ["quality-check"],
}
for key, value in expected.items():
    if data.get(key) != value:
        raise SystemExit(f"backend mobile-api: {key} must be {value!r}, got {data.get(key)!r}")

declared_files = {"product-lifecycle.toml", "quality-check"}
actual_files = {
    path.relative_to(root).as_posix()
    for path in root.rglob("*")
    if path.is_file()
}
unexpected = sorted(actual_files - declared_files)
if unexpected:
    raise SystemExit(
        "backend mobile-api preselection contains undeclared product material: "
        + ", ".join(unexpected)
    )
PY

printf '%s\n' 'backend mobile-api: preselection verified (no production material)'
