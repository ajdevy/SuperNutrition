{
  "name": "@supernutrition/mobile-api",
  "version": "0.1.0",
  "private": true,
  "description": "SuperNutrition mobile API \u2014 first-party inference gateway and product API",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/database",
    "apps/api"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p apps/api/tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config=packages/database/drizzle.config.ts",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
