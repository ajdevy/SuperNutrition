# Copy to .env for local development. Real secrets come from the platform secret
# manager at runtime and never live in this repository (docs/09 §9.8).
# Startup validates every required variable and rejects placeholder values, so a
# misconfigured process fails at boot rather than at the first user request.

NODE_ENV=development
APP_ENVIRONMENT=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://supernutrition:supernutrition@localhost:5432/supernutrition
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

REDIS_URL=redis://localhost:6379

# Generate a real RS256 keypair for local use. These placeholders are rejected.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=supernutrition-mobile-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Hands out sessions without installation attestation.
# The process REFUSES TO START with this enabled when NODE_ENV or
# APP_ENVIRONMENT is production, and test-mode tokens can never authorize a real
# remote transfer in any environment (docs/09 §9.2).
TEST_MODE=true

# Provider credentials. Absent in local development; the gateway returns a typed
# failure rather than starting without them.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
USDA_API_KEY=

MODEL_PROFILES_PATH=./config/model-profiles.toml
TELEMETRY_ALLOWLIST_PATH=./config/telemetry-allowlist.toml

# Operator-controlled provider kill switch (AD-24). Effective without a deploy.
REMOTE_INFERENCE_ENABLED=true

LOG_LEVEL=debug
