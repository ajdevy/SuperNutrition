# Copy to .env for local development. Real secrets come from the platform secret
# manager at runtime and never live in this repository (docs/09 §9.8).
# Startup validates every required variable and rejects placeholder values, so a
# misconfigured process fails at boot rather than at the first user request.

NODE_ENV=development
APP_ENVIRONMENT=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://supernutrition:supernutrition@localhost:5432/supernutrition
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Read only when GATEWAY_STATE_BACKEND=redis. With the default memory backend
# this value is validated and unused.
REDIS_URL=redis://localhost:6379

# Where the gateway's shared state lives (#49).
#
#   memory  single instance. Replay, at-most-once effects, rate limits and
#           Product idempotency are per-process, and APP_INSTANCE_COUNT > 1 is
#           refused.
#   redis   all of them shared across instances, and that refusal is lifted.
#
# Product idempotency stores only a status, a request digest and the meal's ID.
# The response body stays in Postgres and is re-read on replay: a meal diary
# entry is user content, and Redis is a coordination store.
#
# Explicit rather than inferred from REDIS_URL being populated: switching the
# correctness model of the service on whether a variable happens to be set is
# the kind of silent decision this work exists to remove.
#
# Image bytes are NEVER written to Redis in either mode (AD-8). An instance that
# does not hold an attempt's bytes fails closed rather than having them sent to
# it.
GATEWAY_STATE_BACKEND=memory

# How many instances of this service you are running. Because the state above is
# per-process, a second instance shares none of it and one attempt can reach a
# provider twice.
#
# With GATEWAY_STATE_BACKEND=memory, a value greater than 1 fails at boot. Note
# what that is and is not: it is a SELF-REPORT, not enforcement. Two containers
# each declaring 1 — or omitting this — both start, and both call the provider.
# Single-instance operation has to be enforced in the deployment control plane;
# this only stops an operator holding the constraint wrongly while believing
# otherwise. With the redis backend the refusal is lifted, because the state is
# no longer per-process.
APP_INSTANCE_COUNT=1

# Generate a real RS256 keypair for local use. These placeholders are rejected.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=supernutrition-mobile-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Hands out sessions without installation attestation.
# The process REFUSES TO START with this enabled when NODE_ENV or
# APP_ENVIRONMENT is production, and test-mode tokens can never authorize a real
# remote transfer in any environment (docs/09 §9.2).
TEST_MODE=true

# Provider credentials. Absent in local development; the gateway returns a typed
# failure rather than starting without them.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
USDA_API_KEY=

MODEL_PROFILES_PATH=./config/model-profiles.toml
TELEMETRY_ALLOWLIST_PATH=./config/telemetry-allowlist.toml

# Operator-controlled provider kill switch (AD-24). Effective without a deploy.
REMOTE_INFERENCE_ENABLED=true

LOG_LEVEL=debug
