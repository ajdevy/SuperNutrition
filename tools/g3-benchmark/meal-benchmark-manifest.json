{
  "schema": "supernutrition.g3-meal-benchmark.v1",
  "scope": "visible-ingredient-set-and-plated-mass",
  "ground_truth_policy": {
    "ingredient_labels": "visible-manual-annotation",
    "ingredient_definition": "Only visibly separable food components are annotated; hidden recipe ingredients, oil, salt, and dressing composition are excluded.",
    "weight_definition": "Mass in grams for each visible ingredient plus optional total plated food mass after taring the empty plate or bowl.",
    "weight_ground_truth": "required-from-calibrated-scale",
    "weight_capture_protocol": [
      "Tare the empty serving vessel on a calibrated kitchen scale.",
      "Plate the exact meal shown in the photo without removing garnish or sauce.",
      "Record total food mass in grams with scale resolution and timestamp.",
      "Capture one overview photo and one oblique photo on each device tier.",
      "Keep the scale reading and photo fixture ID in the same consented record."
    ]
  },
  "pass_policy": {
    "ingredient_macro_f1_min": 0.85,
    "ingredient_case_f1_min": 0.80,
    "weight_relative_mae_max": 0.15,
    "weight_p90_absolute_error_g_max": 50
  },
