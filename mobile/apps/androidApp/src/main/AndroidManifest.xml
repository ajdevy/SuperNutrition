<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required for the first-party gateway. Without it the app cannot open a
         socket at all and every analysis fails as a transport fault. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".BootstrapApplication"
        android:label="@string/app_name"
        android:theme="@style/BootstrapTheme">
        <activity
            android:name="com.supernutrition.feature.photoanalysis.PhotoAnalysisComposeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
